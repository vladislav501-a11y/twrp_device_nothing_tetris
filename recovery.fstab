#
# Android fstab file for dynamic partitions
# Maintainer: LazymeaoProjects
# SPDX-License-Identifier: Apache-2.0
#

#<src>         <mnt_point>    <type>  <mnt_flags and options>                  <fs_mgr_flags>

system /system erofs ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system /system ext4 noatime,ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext /system_ext erofs ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext /system_ext ext4 noatime,ro wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,readahead_size_kb=128,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor /vendor erofs ro wait,slotselect,avb,logical,first_stage_mount
product /product erofs ro wait,slotselect,avb,logical,first_stage_mount
product /product ext4 noatime,ro wait,slotselect,avb,logical,first_stage_mount,readahead_size_kb=128
odm /odm erofs ro wait,slotselect,avb,logical,first_stage_mount
vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,avb,logical,first_stage_mount
odm_dlkm /odm_dlkm erofs ro wait,slotselect,avb,logical,first_stage_mount
system_dlkm /system_dlkm erofs ro wait,slotselect,avb,logical,first_stage_mount


# ──────────────── METADATA & DATA ────────────────

# /metadata - stores encryption keys and metadata
/dev/block/by-name/metadata  /metadata   ext4   noatime,nosuid,nodev,discard     wait,check,formattable,first_stage_mount

# /data - user data with file-based encryption and compression
/dev/block/by-name/userdata  /data       f2fs   noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt,checkpoint_merge,compress_cache     wait,check,formattable,quota,latemount,resize,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity,sysfs_path=/sys/devices/platform/soc/112b0000.ufshci,fscompress

# ──────────────── MISC / PERSIST ────────────────

# /misc - used by bootloader for bootmode, wipe info, etc.
# Generally does not require formatting
/dev/block/by-name/misc      /misc       emmc   defaults                             defaults

/dev/block/by-name/init_boot /init_boot emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults first_stage_mount,nofail,slotselect
# /persist - used for modem, Wi-Fi, and Bluetooth configs
/dev/block/by-name/persist   /persist    ext4   noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc   wait,check,formattable
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults defaults